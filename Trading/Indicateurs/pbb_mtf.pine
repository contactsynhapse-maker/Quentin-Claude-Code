//@version=6
indicator("PB Blake — Pré-session MTF", shorttitle = "PBB MTF", overlay = true, max_lines_count = 500, max_labels_count = 500)

// ═════════════════════════ PARAMÈTRES ═════════════════════════
G_TF = "Timeframes — biais & FVG"
tf1  = input.timeframe("5",   "TF 1", inline = "1", group = G_TF)
dr1  = input.bool(false,      "Tracer", inline = "1", group = G_TF)
tab1 = input.bool(false,      "Tableau", inline = "1", group = G_TF)
w1   = input.int(1, "Poids", minval = 0, inline = "1", group = G_TF)
tf2  = input.timeframe("15",  "TF 2", inline = "2", group = G_TF)
dr2  = input.bool(true,       "Tracer", inline = "2", group = G_TF)
tab2 = input.bool(true,       "Tableau", inline = "2", group = G_TF)
w2   = input.int(1, "Poids", minval = 0, inline = "2", group = G_TF)
tf3  = input.timeframe("30",  "TF 3", inline = "3", group = G_TF)
dr3  = input.bool(true,       "Tracer", inline = "3", group = G_TF)
tab3 = input.bool(false,      "Tableau", inline = "3", group = G_TF)
w3   = input.int(2, "Poids", minval = 0, inline = "3", group = G_TF)
tf4  = input.timeframe("60",  "TF 4", inline = "4", group = G_TF)
dr4  = input.bool(true,       "Tracer", inline = "4", group = G_TF)
tab4 = input.bool(true,       "Tableau", inline = "4", group = G_TF)
w4   = input.int(2, "Poids", minval = 0, inline = "4", group = G_TF)
tf5  = input.timeframe("240", "TF 5", inline = "5", group = G_TF)
dr5  = input.bool(true,       "Tracer", inline = "5", group = G_TF)
tab5 = input.bool(true,       "Tableau", inline = "5", group = G_TF)
w5   = input.int(3, "Poids", minval = 0, inline = "5", group = G_TF)
tf6  = input.timeframe("D",   "TF 6", inline = "6", group = G_TF)
dr6  = input.bool(true,       "Tracer", inline = "6", group = G_TF)
tab6 = input.bool(true,       "Tableau", inline = "6", group = G_TF)
w6   = input.int(3, "Poids", minval = 0, inline = "6", group = G_TF)

G_D = "Affichage"
showFVG  = input.bool(true,  "FVG", inline = "a", group = G_D)
showIM   = input.bool(true,  "ITL / ITH", inline = "a", group = G_D)
showIFVG = input.bool(false, "IFVG (entrées)", inline = "b", group = G_D)
showCISD = input.bool(false, "CISD (entrées)", inline = "b", group = G_D)
showRB   = input.bool(false, "Rejection blocks", inline = "c", group = G_D)
showLiq  = input.bool(false, "Liquidité (PDH/PDL, PWH/PWL, Asie, Londres)", group = G_D)
fvgEdge  = input.string("Début", "Ligne de la FVG", options = ["Début", "Milieu", "Bord proche"], group = G_D)
lnLen    = input.int(8, "Longueur des lignes (en bougies du TF)", minval = 2, group = G_D)
txtCol   = input.color(color.black, "Couleur des lignes et du texte", group = G_D)

G_DET = "Détection"
maxPerTF = input.int(6, "FVG gardées par TF", minval = 1, maxval = 30, group = G_DET)
minGap   = input.float(0.0, "Taille min. d'une FVG (points)", minval = 0, group = G_DET)
maxLv    = input.int(6, "ITL / ITH max. affichés", minval = 1, maxval = 50, group = G_DET)
rbTF     = input.timeframe("15", "Rejection block : TF minimum de la FVG", group = G_DET)
rbWick   = input.float(0.4, "Rejection block : mèche min. (part de la bougie)", minval = 0.1, maxval = 0.9, step = 0.05, group = G_DET)
rbMinSec = timeframe.in_seconds(rbTF)

G_CI = "CISD (timeframe du graphique)"
cisdLen     = input.int(10, "Plus bas / plus haut balayé sur N bougies", minval = 3, group = G_CI)
cisdInZone  = input.bool(true, "Seulement si le balayage touche une FVG/IFVG 15m+", group = G_CI)
alertOn     = input.bool(true, "Alerte : CISD dans le sens du biais", group = G_CI)
alertNYonly = input.bool(true, "Alerte seulement pendant la fenêtre NY", group = G_CI)

G_CH = "Range / marché choppy"
chopOn    = input.bool(true, "Détecter les ranges (pas de biais si le marché ne respecte rien)", group = G_CH)
chopN     = input.int(6, "Fenêtre : derniers N événements FVG par TF", minval = 4, maxval = 20, group = G_CH)
chopFlips = input.int(3, "TF en range si ≥ N changements de sens (+ FVG ↑ et ↓ cassées)", minval = 1, maxval = 19, group = G_CH)
chopPct   = input.int(40, "Marché en RANGE si ≥ X % du poids des TF en range", minval = 1, maxval = 100, group = G_CH)
convPct   = input.int(30, "Biais seulement si |score| ≥ X % du score max", minval = 0, maxval = 100, group = G_CH)

G_S = "Sessions (heure de New York)"
nySess   = input.session("0930-1100", "Fenêtre de trading", group = G_S)
showNYbg = input.bool(false, "Surligner la fenêtre", group = G_S)
asiaSess = input.session("2000-2359", "Session Asie", group = G_S)
lonSess  = input.session("0200-0500", "Session Londres", group = G_S)

G_T = "Tableau"
tblPos  = input.string("Haut droite", "Position", options = ["Haut droite", "Haut gauche", "Bas droite", "Bas gauche"], group = G_T)
tblSize = input.string("Petit", "Taille", options = ["Minuscule", "Petit", "Normal"], group = G_T)

// ═════════════════════════ TYPES & ÉTAT ═════════════════════════
type FVG
    float  top
    float  bot
    bool   bull            // sens à la création
    int    tfIdx
    int    sec
    string nm
    bool   draw   = false  // TF coché « Tracer »
    int    state  = 0      // 0 = FVG active, 1 = inversée (IFVG)
    bool   tapped = false
    float  tapExt = na     // mèche la plus profonde dans la FVG
    int    tapT   = na
    float  refExt = na     // plus haut (↑) / plus bas (↓) avant le retracement
    float  runExt = na
    bool   imDone = false
    line   ln     = na
    label  lb     = na

// Niveau tracé (ITL/ITH, CISD) : supprimé quand une clôture le casse
type Lvl
    float price
    bool  bull
    line  ln
    label lb

// Rejection block : invalidé sur clôture du TF au-delà de la mèche
type RB
    float inv
    bool  bull
    int   tfIdx
    line  ln
    label lb

// Historique des derniers événements FVG d'un TF (pour détecter les ranges)
type Hist
    array<int> dirs        // +1 / -1
    array<int> brk         // 1 = cassure (FVG invalidée), 0 = respect / nouvelle FVG

var array<FVG>    fvgs    = array.new<FVG>()
var array<RB>     rbs     = array.new<RB>()
var array<Lvl>    ims     = array.new<Lvl>()
var array<Lvl>    cisds   = array.new<Lvl>()
var array<int>    biasArr = array.new_int(6, 0)
var array<string> txtArr  = array.new_string(6, "—")
var array<Hist>   hists   = array.from(Hist.new(array.new_int(), array.new_int()), Hist.new(array.new_int(), array.new_int()), Hist.new(array.new_int(), array.new_int()), Hist.new(array.new_int(), array.new_int()), Hist.new(array.new_int(), array.new_int()), Hist.new(array.new_int(), array.new_int()))

// ═════════════════════════ OUTILS ═════════════════════════
// Nom court sur le graphique : « 5m », « 1h », « D »
tfName(string tf) =>
    int s = timeframe.in_seconds(tf)
    s >= 604800 ? "W" : s >= 86400 ? "D" : s >= 3600 ? str.tostring(math.round(s / 3600)) + "h" : str.tostring(math.round(s / 60)) + "m"

// Nom dans le tableau : « 15 min », « 60 min », « D »
tblName(string tf) =>
    int s = timeframe.in_seconds(tf)
    s >= 604800 ? "W" : s >= 86400 ? "D" : str.tostring(math.round(s / 60)) + " min"

// Sens de la zone : FVG ↑ active ou IFVG issue d'une FVG ↓ = support (+1)
zoneDir(FVG f) => f.state == 0 ? (f.bull ? 1 : -1) : (f.bull ? -1 : 1)

// Ligne fine + texte centré dessus (fond du texte = fond du graphique → la ligne paraît coupée)
mkTag(int x1, float p, int durMs, string txt) =>
    line  ln = line.new(x1, p, x1 + durMs, p, xloc = xloc.bar_time, color = txtCol, width = 1)
    label lb = label.new(x1 + int(durMs / 2), p, txt, xloc = xloc.bar_time, style = label.style_label_center, color = chart.bg_color, textcolor = txtCol, size = size.small)
    [ln, lb]

// Prix de la ligne d'une FVG. « Début » = bord d'où part le gap (bas d'une FVG ↑, haut d'une FVG ↓)
fvgPx(bool bull, float top, float bot) =>
    fvgEdge == "Milieu" ? (top + bot) / 2 : fvgEdge == "Bord proche" ? (bull ? top : bot) : (bull ? bot : top)

hideFVG(FVG f) =>
    line.delete(f.ln)
    label.delete(f.lb)
    f.ln := na
    f.lb := na

addLvl(array<Lvl> arr, float p, bool bull, int t, int durMs, string txt, int maxN) =>
    [ln, lb] = mkTag(t, p, durMs, txt)
    array.push(arr, Lvl.new(p, bull, ln, lb))
    if array.size(arr) > maxN
        Lvl o = array.shift(arr)
        line.delete(o.ln)
        label.delete(o.lb)

// Un niveau cassé par une clôture n'a plus d'intérêt → on l'efface
updLvls(array<Lvl> arr) =>
    int n = array.size(arr)
    if n > 0
        for i = n - 1 to 0
            Lvl l = array.get(arr, i)
            if l.bull ? close < l.price : close > l.price
                line.delete(l.ln)
                label.delete(l.lb)
                array.remove(arr, i)

// Rejection block = la mèche (de l'open au low pour ↑, de l'open au high pour ↓) ; ligne à l'open
addRB(float lvl, float inv, bool bull, int idx, string nm, int t, int durMs) =>
    [ln, lb] = mkTag(t, lvl, durMs, nm + " rb")
    array.push(rbs, RB.new(inv, bull, idx, ln, lb))
    if array.size(rbs) > 6
        RB o = array.shift(rbs)
        line.delete(o.ln)
        label.delete(o.lb)

trimTF(int idx) =>
    int cnt = 0
    for f in fvgs
        if f.tfIdx == idx
            cnt += 1
    if cnt > maxPerTF
        int n = array.size(fvgs)
        for i = 0 to n - 1
            FVG f = array.get(fvgs, i)
            if f.tfIdx == idx
                hideFVG(f)
                array.remove(fvgs, i)
                break

// FVG cassée → IFVG (tracée seulement si « IFVG » est coché)
toIFVG(FVG f, int t, int durMs) =>
    hideFVG(f)
    if showIFVG
        [ln, lb] = mkTag(t, fvgPx(f.bull, f.top, f.bot), durMs, f.nm + " ifvg")
        f.ln := ln
        f.lb := lb
    f.state := 1

// Traite une bougie HTF qui vient de clôturer (h1/l1/c1 = bougie close, h3/l3 = 2 bougies avant)
processTF(int idx, string nm, int sec, bool drawIt, float h1, float l1, float c1, float h3, float l3, int t1, int t2, float o1) =>
    int    evDir  = 0
    int    evPri  = 0
    string evTxt  = ""
    bool   rbMade = false
    int    durMs  = lnLen * sec * 1000
    int nr = array.size(rbs)
    if nr > 0
        for i = nr - 1 to 0
            RB r = array.get(rbs, i)
            if r.tfIdx == idx and (r.bull ? c1 < r.inv : c1 > r.inv)
                line.delete(r.ln)
                label.delete(r.lb)
                array.remove(rbs, i)
    int n = array.size(fvgs)
    if n > 0
        for i = n - 1 to 0
            FVG f = array.get(fvgs, i)
            if f.tfIdx == idx
                if f.state == 0
                    if f.bull
                        // ITL confirmé : on repasse au-dessus du plus haut d'avant le retracement.
                        // Le niveau intéressant devient l'ITL → on n'affiche plus la FVG.
                        if f.tapped and not f.imDone and h1 > f.refExt
                            f.imDone := true
                            hideFVG(f)
                            if showIM and f.draw
                                addLvl(ims, f.tapExt, true, f.tapT, durMs, nm + " ITL", maxLv)
                        if c1 < f.bot   // clôture sous la FVG → IFVG baissière
                            toIFVG(f, t1, durMs)
                            if evPri < 3
                                evDir := -1
                                evPri := 3
                                evTxt := "Break Bull ▼"
                        else if l1 <= f.top   // mèche dedans, pas de clôture en dessous → respectée
                            if not f.tapped
                                f.tapped := true
                                f.refExt := f.runExt
                                f.tapExt := l1
                                f.tapT   := t1
                            else if not f.imDone and l1 < f.tapExt
                                f.tapExt := l1
                                f.tapT   := t1
                            // Rejection block ↑ : bougie HAUSSIÈRE avec grosse mèche basse dans la FVG
                            if not rbMade and sec >= rbMinSec and c1 > o1 and (h1 - l1) > 0 and (o1 - l1) >= rbWick * (h1 - l1)
                                rbMade := true
                                if showRB and f.draw
                                    addRB(o1, l1, true, idx, nm, t1, durMs)
                                if evPri < 2
                                    evDir := 1
                                    evPri := 2
                                    evTxt := "RB Bull ▲"
                            if evPri < 1
                                evDir := 1
                                evPri := 1
                                evTxt := "Respect Bull ▲"
                        else if not f.tapped
                            f.runExt := math.max(f.runExt, h1)
                    else
                        if f.tapped and not f.imDone and l1 < f.refExt
                            f.imDone := true
                            hideFVG(f)
                            if showIM and f.draw
                                addLvl(ims, f.tapExt, false, f.tapT, durMs, nm + " ITH", maxLv)
                        if c1 > f.top   // clôture au-dessus → IFVG haussière
                            toIFVG(f, t1, durMs)
                            if evPri < 3
                                evDir := 1
                                evPri := 3
                                evTxt := "Break Bear ▲"
                        else if h1 >= f.bot
                            if not f.tapped
                                f.tapped := true
                                f.refExt := f.runExt
                                f.tapExt := h1
                                f.tapT   := t1
                            else if not f.imDone and h1 > f.tapExt
                                f.tapExt := h1
                                f.tapT   := t1
                            // Rejection block ↓ : bougie BAISSIÈRE avec grosse mèche haute dans la FVG
                            if not rbMade and sec >= rbMinSec and c1 < o1 and (h1 - l1) > 0 and (h1 - o1) >= rbWick * (h1 - l1)
                                rbMade := true
                                if showRB and f.draw
                                    addRB(o1, h1, false, idx, nm, t1, durMs)
                                if evPri < 2
                                    evDir := -1
                                    evPri := 2
                                    evTxt := "RB Bear ▼"
                            if evPri < 1
                                evDir := -1
                                evPri := 1
                                evTxt := "Respect Bear ▼"
                        else if not f.tapped
                            f.runExt := math.min(f.runExt, l1)
                else
                    if f.bull   // IFVG baissière (ancienne FVG ↑)
                        if c1 > f.top
                            hideFVG(f)
                            array.remove(fvgs, i)
                        else if h1 >= f.bot and evPri < 1
                            evDir := -1
                            evPri := 1
                            evTxt := "Respect IFVG ▼"
                    else        // IFVG haussière (ancienne FVG ↓)
                        if c1 < f.bot
                            hideFVG(f)
                            array.remove(fvgs, i)
                        else if l1 <= f.top and evPri < 1
                            evDir := 1
                            evPri := 1
                            evTxt := "Respect IFVG ▲"
    // Nouvelle FVG
    if l1 > h3 and (l1 - h3) >= minGap
        FVG nf = FVG.new(top = l1, bot = h3, bull = true, tfIdx = idx, sec = sec, nm = nm, draw = drawIt, runExt = h1)
        if showFVG and drawIt
            [ln, lb] = mkTag(t2, fvgPx(true, l1, h3), durMs, nm + " fvg")
            nf.ln := ln
            nf.lb := lb
        array.push(fvgs, nf)
        trimTF(idx)
        if evPri < 2
            evDir := 1
            evPri := 2
            evTxt := "New Bull ▲"
    else if h1 < l3 and (l3 - h1) >= minGap
        FVG nf = FVG.new(top = l3, bot = h1, bull = false, tfIdx = idx, sec = sec, nm = nm, draw = drawIt, runExt = l1)
        if showFVG and drawIt
            [ln, lb] = mkTag(t2, fvgPx(false, l3, h1), durMs, nm + " fvg")
            nf.ln := ln
            nf.lb := lb
        array.push(fvgs, nf)
        trimTF(idx)
        if evPri < 2
            evDir := -1
            evPri := 2
            evTxt := "New Bear ▼"
    if evDir != 0
        array.set(biasArr, idx, evDir)
        array.set(txtArr, idx, evTxt)
        Hist hs = array.get(hists, idx)
        array.push(hs.dirs, evDir)
        array.push(hs.brk, evPri == 3 ? 1 : 0)
        if array.size(hs.dirs) > chopN
            array.shift(hs.dirs)
            array.shift(hs.brk)
    evDir

// Le balayage (plus bas/haut) touche-t-il une zone 15m+ du bon sens ?
inZone(float p, int dir) =>
    bool r = false
    for f in fvgs
        if not r and f.sec >= 900 and zoneDir(f) == dir
            float h = f.top - f.bot
            if dir == 1 and p <= f.top and p >= f.bot - h
                r := true
            if dir == -1 and p >= f.bot and p <= f.top + h
                r := true
    r

// Structure du TF : 1 = HH/HL, -1 = LH/LL, 2 = HH/LL, 3 = LH/HL, 0 = pas assez de swings
structCalc() =>
    var float ph1 = na
    var float ph2 = na
    var float pl1 = na
    var float pl2 = na
    float ph = ta.pivothigh(high, 2, 2)
    float pl = ta.pivotlow(low, 2, 2)
    if not na(ph)
        ph2 := ph1
        ph1 := ph
    if not na(pl)
        pl2 := pl1
        pl1 := pl
    int s = 0
    if not na(ph2) and not na(pl2)
        s := ph1 > ph2 ? (pl1 > pl2 ? 1 : 2) : (pl1 > pl2 ? 3 : -1)
    s

// Valeur à la dernière bougie CLÔTURÉE (pas de repaint)
structPrev() =>
    int s = structCalc()
    s[1]

// ═════════════════════════ DONNÉES MULTI-TIMEFRAME ═════════════════════════
// [1] + lookahead_on = dernière bougie HTF CLÔTURÉE → aucun repaint
chartSec = timeframe.in_seconds()
s1 = timeframe.in_seconds(tf1)
s2 = timeframe.in_seconds(tf2)
s3 = timeframe.in_seconds(tf3)
s4 = timeframe.in_seconds(tf4)
s5 = timeframe.in_seconds(tf5)
s6 = timeframe.in_seconds(tf6)
v1 = s1 >= chartSec
v2 = s2 >= chartSec
v3 = s3 >= chartSec
v4 = s4 >= chartSec
v5 = s5 >= chartSec
v6 = s6 >= chartSec

[ha1, la1, ca1, hc1, lc1, tb1, ta1, oa1, st1] = request.security(syminfo.tickerid, tf1, [high[1], low[1], close[1], high[3], low[3], time[2], time[1], open[1], structPrev()], lookahead = barmerge.lookahead_on)
[ha2, la2, ca2, hc2, lc2, tb2, ta2, oa2, st2] = request.security(syminfo.tickerid, tf2, [high[1], low[1], close[1], high[3], low[3], time[2], time[1], open[1], structPrev()], lookahead = barmerge.lookahead_on)
[ha3, la3, ca3, hc3, lc3, tb3, ta3, oa3, st3] = request.security(syminfo.tickerid, tf3, [high[1], low[1], close[1], high[3], low[3], time[2], time[1], open[1], structPrev()], lookahead = barmerge.lookahead_on)
[ha4, la4, ca4, hc4, lc4, tb4, ta4, oa4, st4] = request.security(syminfo.tickerid, tf4, [high[1], low[1], close[1], high[3], low[3], time[2], time[1], open[1], structPrev()], lookahead = barmerge.lookahead_on)
[ha5, la5, ca5, hc5, lc5, tb5, ta5, oa5, st5] = request.security(syminfo.tickerid, tf5, [high[1], low[1], close[1], high[3], low[3], time[2], time[1], open[1], structPrev()], lookahead = barmerge.lookahead_on)
[ha6, la6, ca6, hc6, lc6, tb6, ta6, oa6, st6] = request.security(syminfo.tickerid, tf6, [high[1], low[1], close[1], high[3], low[3], time[2], time[1], open[1], structPrev()], lookahead = barmerge.lookahead_on)

nb1 = v1 and not na(ta1) and nz(ta1[1]) != ta1
nb2 = v2 and not na(ta2) and nz(ta2[1]) != ta2
nb3 = v3 and not na(ta3) and nz(ta3[1]) != ta3
nb4 = v4 and not na(ta4) and nz(ta4[1]) != ta4
nb5 = v5 and not na(ta5) and nz(ta5[1]) != ta5
nb6 = v6 and not na(ta6) and nz(ta6[1]) != ta6

// Noms des TF calculés une fois (timeframe.in_seconds exige une chaîne « simple »)
nm1 = tfName(tf1)
nm2 = tfName(tf2)
nm3 = tfName(tf3)
nm4 = tfName(tf4)
nm5 = tfName(tf5)
nm6 = tfName(tf6)

if nb1
    processTF(0, nm1, s1, dr1, ha1, la1, ca1, hc1, lc1, ta1, tb1, oa1)
if nb2
    processTF(1, nm2, s2, dr2, ha2, la2, ca2, hc2, lc2, ta2, tb2, oa2)
if nb3
    processTF(2, nm3, s3, dr3, ha3, la3, ca3, hc3, lc3, ta3, tb3, oa3)
if nb4
    processTF(3, nm4, s4, dr4, ha4, la4, ca4, hc4, lc4, ta4, tb4, oa4)
if nb5
    processTF(4, nm5, s5, dr5, ha5, la5, ca5, hc5, lc5, ta5, tb5, oa5)
if nb6
    processTF(5, nm6, s6, dr6, ha6, la6, ca6, hc6, lc6, ta6, tb6, oa6)

updLvls(ims)

// ═════════════════════════ BIAIS GLOBAL ═════════════════════════
wArr = array.from(w1, w2, w3, w4, w5, w6)
vArr = array.from(v1, v2, v3, v4, v5, v6)
var array<bool> chopArr = array.new_bool(6, false)
float score    = 0
float maxScore = 0
float chopW    = 0
for i = 0 to 5
    if array.get(vArr, i)
        int  w   = array.get(wArr, i)
        Hist hs  = array.get(hists, i)
        int  cnt = array.size(hs.dirs)
        int  flips = 0
        int  bBull = 0   // FVG ↑ cassées
        int  bBear = 0   // FVG ↓ cassées
        if cnt > 0
            for j = 0 to cnt - 1
                int d = array.get(hs.dirs, j)
                if j > 0 and d != array.get(hs.dirs, j - 1)
                    flips += 1
                if array.get(hs.brk, j) == 1
                    if d == -1
                        bBull += 1
                    else
                        bBear += 1
        // Range : ni les FVG ↑ ni les FVG ↓ ne sont respectées, et le sens change sans arrêt
        bool ch = chopOn and cnt >= 4 and bBull > 0 and bBear > 0 and flips >= chopFlips
        array.set(chopArr, i, ch)
        maxScore += w
        if ch
            chopW += w          // un TF en range ne vote pas
        else
            score += array.get(biasArr, i) * w
chopShare = maxScore > 0 ? chopW / maxScore : 0.0
conv      = maxScore > 0 ? math.abs(score) / maxScore : 0.0
isRange   = chopOn and chopShare * 100 >= chopPct
rawSign   = score > 0 ? 1 : score < 0 ? -1 : 0
// Pas de biais « par défaut » : range ou conviction trop faible → 0
biasSign  = isRange ? 0 : conv * 100 >= convPct ? rawSign : 0

// ═════════════════════════ SESSIONS & LIQUIDITÉ ═════════════════════════
inS(string s) => not na(time(timeframe.period, s, "America/New_York"))
inNY   = inS(nySess)
inAsia = inS(asiaSess)
inLon  = inS(lonSess)
bgcolor(showNYbg and inNY ? color.new(color.blue, 93) : na, title = "Fenêtre NY")

sessHL(bool inSess) =>
    var float h  = na
    var float l  = na
    var int   t  = na
    var bool  hT = false
    var bool  lT = false
    if inSess and not inSess[1]
        h  := high
        l  := low
        t  := time
        hT := false
        lT := false
    else if inSess
        h := math.max(h, high)
        l := math.min(l, low)
    else
        if high > h
            hT := true
        if low < l
            lT := true
    [h, l, t, hT, lT]

[aH, aL, aT, aHT, aLT] = sessHL(inAsia)
[lH, lL, lT, lHT, lLT] = sessHL(inLon)

[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[pwh, pwl] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = barmerge.lookahead_on)

var float dayH = na
var float dayL = na
var int   dayT = na
var float wkH  = na
var float wkL  = na
var int   wkT  = na
if timeframe.change("D") or na(dayH)
    dayH := high
    dayL := low
    dayT := time
else
    dayH := math.max(dayH, high)
    dayL := math.min(dayL, low)
if timeframe.change("W") or na(wkH)
    wkH := high
    wkL := low
    wkT := time
else
    wkH := math.max(wkH, high)
    wkL := math.min(wkL, low)

mkLine() => line.new(time, close, time + 1, close, xloc = xloc.bar_time, color = color.new(color.white, 100))
mkLabel() => label.new(time, close, "", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = color.new(color.white, 100), size = size.small)
var array<line>  liqLn = array.from(mkLine(), mkLine(), mkLine(), mkLine(), mkLine(), mkLine(), mkLine(), mkLine())
var array<label> liqLb = array.from(mkLabel(), mkLabel(), mkLabel(), mkLabel(), mkLabel(), mkLabel(), mkLabel(), mkLabel())

// ═════════════════════════ CISD (TF du graphique) ═════════════════════════
// CISD ↑ : après un balayage de plus bas, clôture au-dessus de l'OPEN de la
// première bougie de la série baissière qui a fait ce plus bas. Miroir pour ↓.
isBear  = close < open
isBull  = close > open
newLow  = low  <= ta.lowest(low, cisdLen)
newHigh = high >= ta.highest(high, cisdLen)

var float bearRunOpen = na
var int   bearRunT    = na
var float bullRunOpen = na
var int   bullRunT    = na
if isBear and not isBear[1]
    bearRunOpen := open
    bearRunT    := time
if isBull and not isBull[1]
    bullRunOpen := open
    bullRunT    := time

var float armUp    = na
var int   armUpT   = na
var float armUpExt = na
var float armDn    = na
var int   armDnT   = na
var float armDnExt = na
if newLow and not na(bearRunOpen)
    armUp    := bearRunOpen
    armUpT   := bearRunT
    armUpExt := low
if newHigh and not na(bullRunOpen)
    armDn    := bullRunOpen
    armDnT   := bullRunT
    armDnExt := high

int cisdMs = lnLen * chartSec * 1000
bool cisdUp = false
bool cisdDn = false
if not na(armUp) and close > armUp
    if not cisdInZone or inZone(armUpExt, 1)
        cisdUp := true
        if showCISD
            addLvl(cisds, armUp, true, armUpT, cisdMs, "cisd", 4)
    armUp := na
if not na(armDn) and close < armDn
    if not cisdInZone or inZone(armDnExt, -1)
        cisdDn := true
        if showCISD
            addLvl(cisds, armDn, false, armDnT, cisdMs, "cisd", 4)
    armDn := na
updLvls(cisds)

if alertOn and (inNY or not alertNYonly)
    if cisdUp and biasSign == 1
        alert("PBB : CISD ↑ dans le sens du biais — " + syminfo.ticker + " @ " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)
    if cisdDn and biasSign == -1
        alert("PBB : CISD ↓ dans le sens du biais — " + syminfo.ticker + " @ " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)

// ═════════════════════════ TABLEAU ═════════════════════════
tPos = switch tblPos
    "Haut gauche" => position.top_left
    "Bas droite"  => position.bottom_right
    "Bas gauche"  => position.bottom_left
    => position.top_right
tsz = switch tblSize
    "Minuscule" => size.tiny
    "Normal"    => size.normal
    => size.small

var table tbl = table.new(tPos, 3, 8, border_width = 1, border_color = chart.bg_color)

cell(int c, int r, string t, color tc, color bg) =>
    table.cell(tbl, c, r, t, text_color = tc, text_size = tsz, bgcolor = bg)

cHdr  = color.rgb(93, 96, 107)
cLbl  = color.rgb(134, 137, 147)
cBull = color.rgb(76, 175, 80)
cBear = color.rgb(239, 83, 80)
cGray = color.rgb(134, 137, 147)
cWht  = color.white

dirCol(int b) => b == 1 ? cBull : b == -1 ? cBear : cGray

if barstate.islast
    // Liquidité (option)
    names  = array.from("PDH", "PDL", "PWH", "PWL", "Asie H", "Asie L", "Londres H", "Londres L")
    prices = array.from(pdh, pdl, pwh, pwl, aH, aL, lH, lL)
    takens = array.from(dayH > pdh, dayL < pdl, wkH > pwh, wkL < pwl, aHT, aLT, lHT, lLT)
    starts = array.from(dayT, dayT, wkT, wkT, aT, aT, lT, lT)
    for i = 0 to 7
        line  ln = array.get(liqLn, i)
        label lb = array.get(liqLb, i)
        float p  = array.get(prices, i)
        if showLiq and not na(p) and not array.get(takens, i) and chartSec < 86400
            int x1 = na(array.get(starts, i)) ? time - 1 : math.min(array.get(starts, i), time - 1)
            line.set_xy1(ln, x1, p)
            line.set_xy2(ln, time, p)
            line.set_color(ln, txtCol)
            line.set_style(ln, line.style_dotted)
            label.set_xy(lb, time, p)
            label.set_text(lb, array.get(names, i))
            label.set_textcolor(lb, txtCol)
        else
            line.set_color(ln, color.new(color.white, 100))
            label.set_textcolor(lb, color.new(color.white, 100))

    // Tableau : biais du jour + structure et dernier signal FVG par TF
    string bTxt = isRange ? "RANGE ↔" : biasSign == 1 ? "BULLISH ▲" : biasSign == -1 ? "BEARISH ▼" : "NEUTRE"
    color  bBg  = biasSign == 1 ? cBull : biasSign == -1 ? cBear : cLbl
    cell(0, 0, "BIAS DU JOUR", cWht, cHdr)
    cell(1, 0, bTxt, cWht, bBg)
    cell(2, 0, "Score: " + str.tostring(score, "#"), cWht, cHdr)
    cell(0, 1, "", cWht, cLbl)
    cell(1, 1, "Structure", cWht, cLbl)
    cell(2, 1, "FVG", cWht, cLbl)
    tns   = array.from(tblName(tf1), tblName(tf2), tblName(tf3), tblName(tf4), tblName(tf5), tblName(tf6))
    tabs  = array.from(tab1, tab2, tab3, tab4, tab5, tab6)
    sts   = array.from(st1, st2, st3, st4, st5, st6)
    int row = 2
    for i = 0 to 5
        if array.get(vArr, i) and array.get(tabs, i)
            int  st = array.get(sts, i)
            int  b  = array.get(biasArr, i)
            bool ch = array.get(chopArr, i)
            string sTxt = st == 1 ? "HH/HL ▲" : st == -1 ? "LH/LL ▼" : st == 2 ? "HH/LL" : st == 3 ? "LH/HL" : "—"
            cell(0, row, array.get(tns, i), cWht, cLbl)
            cell(1, row, sTxt, st == 1 ? cBull : st == -1 ? cBear : cGray, chart.bg_color)
            cell(2, row, ch ? "Range ↔" : array.get(txtArr, i), ch ? cGray : dirCol(b), chart.bg_color)
            row += 1
